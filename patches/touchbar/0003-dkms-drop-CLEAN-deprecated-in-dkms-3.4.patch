From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DriftDeV <noreply@users.noreply.github.com>
Date: Mon, 23 Nov 2026 15:15:49 +0100
Subject: [PATCH] dkms: drop CLEAN (deprecated in dkms 3.4)

dkms 3.4.5 prints 'Deprecated feature: CLEAN' on every build and cleans the
build directory on its own.
---
 dkms.conf | 1 -
 1 file changed, 1 deletion(-)

diff --git a/dkms.conf b/dkms.conf
index b8addde..e1677d9 100644
--- a/dkms.conf
+++ b/dkms.conf
@@ -1,6 +1,5 @@
 PACKAGE_NAME="appleibridge"
 PACKAGE_VERSION="0.1"
-CLEAN="make KERNELRELEASE=${kernelver} clean"
 MAKE[0]="make KERNELRELEASE=${kernelver}"
 BUILT_MODULE_NAME[0]="apple-ibridge"
 BUILT_MODULE_NAME[1]="apple-ib-tb"
-- 
2.56.1

