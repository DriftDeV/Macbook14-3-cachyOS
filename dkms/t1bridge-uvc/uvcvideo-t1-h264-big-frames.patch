diff --color -ru a/uvcvideo.h b/uvcvideo.h
--- a/uvcvideo.h	2026-11-25 00:20:03.490249302 +0100
+++ b/uvcvideo.h	2026-11-25 00:11:54.555242108 +0100
@@ -81,6 +81,7 @@
 #define UVC_QUIRK_INVALID_DEVICE_SOF	0x00010000
 #define UVC_QUIRK_MJPEG_NO_EOF		0x00020000
 #define UVC_QUIRK_MSXU_META		0x00040000
+#define UVC_QUIRK_H264_BIG_FRAMES	0x00080000
 
 /* Format flags */
 #define UVC_FMT_FLAG_COMPRESSED		0x00000001
@@ -715,6 +716,21 @@
 int uvc_mc_register_entities(struct uvc_video_chain *chain);
 void uvc_mc_cleanup_entity(struct uvc_entity *entity);
 
+/*
+ * MacBookPro14,3 (T1, 05ac:8600) in H.264: the camera reports dwMaxVideoFrameSize = 276480, but at ~30 Mbit/s its
+ * larger frames exceed it. The overflowing frame is returned with the error flag (applications drop it) and the
+ * following P-frames are decoded against a missing reference: smearing ("rain") until the next keyframe.
+ * Allocate buffers for a whole uncompressed 4:2:0 frame instead. Only buffer sizes change, nothing sent to the device.
+ */
+static inline u32 uvc_buffer_size(const struct uvc_streaming *stream, const struct uvc_format *format,
+				  const struct uvc_frame *frame, u32 size)
+{
+	if ((stream->dev->quirks & UVC_QUIRK_H264_BIG_FRAMES) && format && frame &&
+	    (format->flags & UVC_FMT_FLAG_COMPRESSED))
+		size = max_t(u32, size, (u32)frame->wWidth * frame->wHeight * 3 / 2);
+	return size;
+}
+
 /* Video */
 int uvc_video_init(struct uvc_streaming *stream);
 int uvc_video_suspend(struct uvc_streaming *stream);
