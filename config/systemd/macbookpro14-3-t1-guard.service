[Unit]
Description=MacBookPro14,3: guardia del firmware del T1 (controlla e ripristina EFI/APPLE/EMBEDDEDOS)
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/macbookpro14-3/t1-guard.sh check

[Install]
WantedBy=multi-user.target
