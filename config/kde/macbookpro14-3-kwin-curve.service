[Unit]
Description=Curva di luminosità automatica di partenza per lo schermo del MacBookPro14,3 (una volta)
Before=plasma-kwin_wayland.service
ConditionPathExists=%h/.config/macbookpro14-3/kwin-brightness-curve.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I %h/.local/share/macbookpro14-3/apply-kwin-brightness-curve.py

[Install]
WantedBy=plasma-kwin_wayland.service
