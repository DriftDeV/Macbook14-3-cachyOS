#!/bin/sh
# Webcam per Discord/browser nella modalità display della Touch Bar (da utente, senza sudo).
# Poi nell'app scegli "T1 camera (Discord)". Il LED della camera resta acceso finché è attiva.
case ${1:-status} in
  on)     systemctl --user start macbookpro14-3-webcam.service && echo "Webcam virtuale accesa: scegli \"T1 camera (Discord)\"" ;;
  off)    systemctl --user stop macbookpro14-3-webcam.service && echo "Webcam virtuale spenta" ;;
  status) systemctl --user is-active macbookpro14-3-webcam.service ;;
  *)      echo "Uso: t1-webcam on|off|status" >&2; exit 2 ;;
esac
